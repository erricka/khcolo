# Copy to .env for docker compose. Never commit the real .env.

# --- Database -------------------------------------------------------------
POSTGRES_DB=khcolo
POSTGRES_USER=khcolo
POSTGRES_PASSWORD=change-me-long-random

# --- Site -----------------------------------------------------------------
# "production" makes the site crawlable. Leave as "development" for staging.
SITE_ENV=development
NEXT_PUBLIC_SITE_URL=https://khcolo.com
# Production only: redirect other hosts to this one and http to https.
CANONICAL_HOST=
ENFORCE_HTTPS=false

# Shared between the API (sender) and the site (receiver).
REVALIDATE_SECRET=change-me-long-random

# --- API ------------------------------------------------------------------
# Leave empty to disable every /api/v1/admin endpoint.
ADMIN_API_TOKEN=change-me-long-random
# Salt for hashing visitor IPs used in rate limiting.
IP_HASH_SALT=change-me-long-random
INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_MINUTES=10
INQUIRY_GLOBAL_HOURLY_LIMIT=120

# Optional inquiry notifications (each channel needs every value set).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
