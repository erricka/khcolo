# Local development settings for the FastAPI service (copy to backend/.env).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://khcolo:khcolo-dev-only@127.0.0.1:5432/khcolo

# Enables /api/v1/admin/* with "Authorization: Bearer <token>".
ADMIN_API_TOKEN=dev-admin-token

# When set, every /api call except /api/v1/health must send X-Internal-Key.
INTERNAL_API_KEY=

# Only true when the API sits behind a proxy you control (the Next.js server).
TRUST_PROXY_HEADERS=false
IP_HASH_SALT=dev-salt-change-me

INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_MINUTES=10
INQUIRY_GLOBAL_HOURLY_LIMIT=120

# Ask the site to regenerate pages after admin edits.
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate/
REVALIDATE_SECRET=local-revalidate-secret

# Optional: Google reCAPTCHA v3 secret key (turns the check on); lowest accepted score
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
