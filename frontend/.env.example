# "production" makes the site crawlable (robots.txt allow + no X-Robots-Tag).
# Anything else (default) keeps the deployment out of search engines.
SITE_ENV=development

# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://khcolo.com

# FastAPI base URL as seen from the Next.js server (not the browser).
# When unset, pages are built from the JSON files in ../content instead.
KHCOLO_API_URL=http://127.0.0.1:8000

# Shared secret the API sends when asking the site to regenerate pages.
REVALIDATE_SECRET=change-me

# Optional: enforce host and HTTPS in proxy.ts (set in production only).
CANONICAL_HOST=
ENFORCE_HTTPS=false
